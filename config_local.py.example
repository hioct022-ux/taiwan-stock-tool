# ════════════════════════════════════════
# config_local.py.example　本機設定範本
#
# 使用方式：
# 1. 複製此檔案，改名為 config_local.py
# 2. 填入你的 GitHub Token
# 3. config_local.py 不會上傳到 GitHub（已在 .gitignore）
# ════════════════════════════════════════

# GitHub Personal Access Token（Classic，有 repo 權限）
# 產生方式：GitHub → Settings → Developer settings → Tokens (classic)
GITHUB_TOKEN = '貼上你的_ghp_開頭的token'
