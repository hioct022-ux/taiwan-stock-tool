__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# macOS 系統檔
.DS_Store

# 環境設定（含敏感資訊，不上傳）
.env
secrets.toml
config_local.py

# Streamlit 本機 cache
.streamlit/secrets.toml
data/*.bak-*
data/.fuse_hidden*
台股分析工具_backup/
backfill_log.txt

